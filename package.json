{
  "name": "real-estate-auction-backend",
  "version": "1.0.0",
  "description": "Backend for منصة مزادات العقار (Real Estate Auction Platform) - Auth + KYC",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed:admin": "ts-node src/seeds/admin.seed.ts",
    "seed:super-admin": "ts-node src/seeds/super-admin.seed.ts",
    "mail:test": "ts-node src/scripts/send-test-email.ts",
    "migrate:006-money": "ts-node src/migrations/006-property-money-minor-units.ts",
    "migrate:007-identity": "ts-node src/migrations/007-user-identity-contract.ts",
    "migration:list": "ts-node src/migrations/cli.ts --list",
    "migration:check": "ts-node src/migrations/cli.ts --dry-run",
    "migration:apply": "ts-node src/migrations/cli.ts --apply",
    "migration:integrity": "ts-node src/migrations/integrity-cli.ts",
    "migration:integrity:strict": "ts-node src/migrations/integrity-cli.ts --fail-on-warning",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^5.1.1",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.0.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.1.1",
    "nodemailer": "^10.0.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "class-transformer": "^0.5.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
