{
  "name": "real-estate-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express MVC real estate backend",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "npm run check",
    "start": "node src/server.js",
    "start:dev": "node --watch src/server.js",
    "start:prod": "node src/server.js",
    "mail:test": "node src/scripts/send-test-email.js",
    "admin:grant": "node src/scripts/admin-grant.js",
    "migration:list": "node src/migrations/cli.js --list",
    "migration:check": "node src/migrations/cli.js --dry-run",
    "migration:apply": "node src/migrations/cli.js --apply",
    "env:init": "node src/scripts/env-init.js",
    "migration:integrity": "node src/migrations/integrity-cli.js",
    "migration:integrity:strict": "node src/migrations/integrity-cli.js --fail-on-warning",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check": "node tools/check.js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" tools/check.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "~6.20.0",
    "mongoose": "^8.1.1",
    "multer": "2.4.0",
    "nodemailer": "^10.0.8",
    "reflect-metadata": "^0.2.1",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "multer": "2.4.0",
    "body-parser": "1.20.8",
    "qs": "6.16.0",
    "lodash": "4.18.1"
  },
  "main": "src/server.js"
}
