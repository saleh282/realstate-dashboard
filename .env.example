PORT=3000
NODE_ENV=development

MONGO_URI=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated. Optional in development; required in production.
CORS_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Keep certificate validation enabled. A local exception must be explicit and
# is rejected when NODE_ENV=production.
MAIL_TLS_REJECT_UNAUTHORIZED=true
TEST_EMAIL_TO=

# Manual, idempotent development admin seed. Use a unique local password.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=ChangeThisDev1!
ADMIN_FULL_NAME=Development Admin

OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=60
